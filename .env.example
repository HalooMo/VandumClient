SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FLASK_ENV=production

# Database — managed cluster example (URL-encode special chars in password)
# DATABASE_URL=postgresql://gen_user:ENCODED_PASSWORD@HOST:PORT/dpunk?sslmode=require
DATABASE_URL=postgresql://dpunk:CHANGE_ME_DB_PASSWORD@localhost:5432/dpunk

# SpeechLab API (upstream inference — NOT this web app URL)
SPEECHLAB_BASE_URL=https://app.vandum.ru
SPEECHLAB_API_KEY=your-api-key-here
SPEECHLAB_MAX_UPLOAD_MB=150

# yt-dlp (download media by URL before dub)
YTDLP_ENABLED=true
YTDLP_TIMEOUT_SEC=600
YTDLP_MAX_DURATION_SEC=3600

# Mail (for email verification)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Dpunk <noreply@dpunk.online>

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App URL (for OAuth callbacks and email links)
# Local: http://localhost:5000  |  Production: https://dpunk.online
APP_URL=https://dpunk.online

# Admin bootstrap (first admin user) — use a strong password in production
ADMIN_EMAIL=admin@dpunk.online
ADMIN_PASSWORD=change-me-strong-password

# Optional: show verify code on page when SMTP fails (dev only)
# DEV_SHOW_VERIFY_CODE=true

# Optional: reset admin password from ADMIN_PASSWORD on boot
# ADMIN_RESET_PASSWORD=false

MAX_DUB_JOBS_PER_DAY=20

# GPU power — Selectel OpenStack shelve/unshelve (SpeechLab inference VM)
# When true, web/API dub waits for unshelve + /health before upload.
GPU_POWER_ENABLED=false
GPU_SERVER_ID=
GPU_WAKE_TIMEOUT_SEC=300
GPU_SHELVE_TIMEOUT_SEC=300
GPU_IDLE_SEC=60
GPU_HEALTH_POLL_SEC=5
GPU_STATUS_POLL_SEC=5
OS_AUTH_URL=https://cloud.api.selcloud.ru/identity/v3
OS_IDENTITY_API_VERSION=3
OS_PROJECT_DOMAIN_NAME=
OS_PROJECT_ID=
OS_USER_DOMAIN_NAME=
OS_USERNAME=
OS_PASSWORD=
OS_REGION_NAME=
